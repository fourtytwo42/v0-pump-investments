{
  "name": "pump-investments",
  "version": "4.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration": "tsx --test tests/postgres-v409.integration.test.ts",
    "test:browser": "playwright test",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "ingest": "tsx --tsconfig tsconfig.json server/ingest-trades.ts",
    "backfill:aggregates": "tsx --tsconfig tsconfig.json scripts/backfill-token-aggregates.ts",
    "backfill:lifecycle": "tsx --tsconfig tsconfig.json scripts/backfill-token-lifecycles.ts",
    "smoke:pi-bot": "tsx --tsconfig tsconfig.json scripts/smoke-pi-bot.ts",
    "pm2:web:restart": "pm2 restart pump-investments-web",
    "pm2:ingest:restart": "pm2 restart pump-investments-ingest",
    "pm2:web:restart-env": "pm2 restart pump-investments-web --update-env",
    "pm2:ingest:restart-env": "pm2 restart pump-investments-ingest --update-env",
    "pm2:restart-env": "pm2 restart pump-investments-web --update-env && pm2 restart pump-investments-ingest --update-env",
    "deploy:vm": "bash deploy/vm-release.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dexie": "4.4.4",
    "dotenv": "17.2.3",
    "framer-motion": "12.43.0",
    "lucide-react": "0.454.0",
    "markdown-to-jsx": "9.9.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "ws": "8.21.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "tailwindcss": "3.4.18",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "diff": "4.0.4",
    "picomatch": "4.0.4",
    "postcss": "8.5.25",
    "next": {
      "sharp": "0.35.3"
    },
    "sucrase": {
      "glob": "13.0.6"
    }
  },
  "//": "IMPORTANT: When updating code, remember to update the version number here, in the header component, and add your changes to the changelog. See components/changelog.tsx for versioning guidelines."
}
