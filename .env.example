DATABASE_URL="postgresql://pumpinvest_user:PumpInvest2025!@localhost:5432/pumpinvestments?schema=public"

# Market cap history retention (set to "true" or "1" to enable)
ENABLE_MARKET_CAP_HISTORY=false

# Ingester reconnect / liveness tuning
INGEST_RECONNECT_MIN_MS=2000
INGEST_RECONNECT_MAX_MS=60000
INGEST_CONNECT_TIMEOUT_MS=10000
INGEST_PING_INTERVAL_MS=15000
INGEST_STALE_AFTER_MS=45000
INGEST_BACKOFF_RESET_AFTER_MS=30000
