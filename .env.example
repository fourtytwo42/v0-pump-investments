DATABASE_URL="postgresql://app_user:change-me@localhost:5432/pumpinvestments?schema=public"
DATABASE_WEB_POOL_MAX=10
DATABASE_INGESTER_POOL_MAX=15
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Pump upstream subscriber credentials belong only in the VM environment.
PUMP_NATS_URL="wss://unified-prod.nats.realtime.pump.fun/"
PUMP_NATS_USER=""
PUMP_NATS_PASSWORD=""
# The global `unifiedTradeEvent.processed` subject is sampled. The per-mint
# wildcard carries the complete processed trade feed.
PUMP_NATS_SUBJECT="unifiedTradeEvent.processed.*"

# Market cap history retention (set to "true" or "1" to enable)
ENABLE_MARKET_CAP_HISTORY=false

# Ingester reconnect / liveness tuning
INGEST_RECONNECT_MIN_MS=2000
INGEST_RECONNECT_MAX_MS=60000
INGEST_CONNECT_TIMEOUT_MS=10000
INGEST_PING_INTERVAL_MS=15000
INGEST_STALE_AFTER_MS=45000
INGEST_BACKOFF_RESET_AFTER_MS=30000

# Ingester metadata backlog tuning
INGEST_METADATA_BATCH_SIZE_NORMAL=25
INGEST_METADATA_BATCH_SIZE_ELEVATED=50
INGEST_METADATA_ACTIVE_WINDOW_MS=1800000
INGEST_METADATA_NOT_FOUND_COOLDOWN_MS=1800000
INGEST_METADATA_TRANSIENT_COOLDOWN_MS=120000
INGEST_METADATA_OVERLOAD_QUEUE_THRESHOLD=1000

# Verified token lifecycle and realtime delivery
LIFECYCLE_VERIFIER_ENABLED=true
LIFECYCLE_BATCH_SIZE=50
LIFECYCLE_ACTIVE_RECHECK_MS=60000
LIFECYCLE_FULL_RECHECK_MS=900000
TOKEN_SSE_ENABLED=true
TOKEN_ALERT_STREAM_ENABLED=true
INGEST_ATOMIC_PIPELINE_ENABLED=true
TOKEN_AGGREGATES_ENABLED=true
TOKEN_CHANGED_JOURNAL_ENABLED=true
TOKEN_IMAGE_CACHE_ENABLED=true
INGEST_SPOOL_DIR="/var/lib/pump-investments/spool"
TOKEN_IMAGE_CACHE_DIR="/var/cache/pump-investments/images"
HEALTH_DETAILS_TOKEN="replace-with-a-long-random-token"
TRADE_RETENTION_HOURS=24

# PI Bot uses the appliance from the Next.js server; browsers never connect to it directly.
PI_BOT_BASE_URL="http://192.168.50.189:30001"
PI_BOT_MODEL="ornith-1.0-35b-Q5_K_M-688b8d0a"
PI_BOT_API_KEY=""
PI_BOT_MAX_CONTEXT_TOKENS=100000
